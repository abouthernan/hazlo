---
const videos = [
  {
    id: 'gqhQowYi8OU',
    thumb: '/videos/back-video-1.png',
    badge: 'Charla',
    title: 'Valida antes de Construir el MVP',
    speaker: 'Damian Sanchez',
    role: 'Cofounder Novolabs',
    duration: '1h 45 min',
    categories: ['Growth'],
  },
  {
    id: 'CY4NGGlOugw',
    thumb: '/videos/back-video-nahuel.png',
    badge: 'Webinar',
    title: 'Levanta capital para tu Startup',
    speaker: 'Nahuel Lema',
    role: 'CEO de Coderhouse',
    duration: '1h 35 min',
    categories: ['Capital'],
  },
  {
    id: 'E5rqHePG-60',
    thumb: '/videos/back-video-salomon.png',
    badge: 'Workshop',
    title: 'Crea un producto que todos quieran',
    speaker: 'Salom Zarruk',
    role: 'CEO de Mono',
    duration: '57 min',
    categories: ['Growth'],
  },
  {
    id: 'C5ZKq9csLpQ',
    thumb: '/videos/back-video-michel.png',
    badge: 'Workshop',
    title: 'Team Building',
    speaker: 'Michel Haeuzeur',
    role: 'CEO la Corte de los Buhos',
    duration: '57 min',
    categories: ['Cowork'],
  },
];

const CATEGORIES = ['Todos', 'Automatización', 'Ventas', 'Growth', 'Claude', 'Cowork', 'Prospección', 'Capital'];
---

<section class="videos-section">
  <div class="videos-container">

    <!-- Header -->
    <div class="section-header">
      <div class="section-badge">
        <span class="badge-icon">🎥</span>
        <span class="badge-text">Contenido exclusivo</span>
      </div>
      <h2 class="section-title">
        Aprende con <span class="title-gradient">expertos</span>
      </h2>
      <p class="section-subtitle">
        Charlas, webinars y workshops con líderes del ecosistema emprendedor
      </p>
    </div>

    <!-- Filter chips -->
    <div class="filter-bar">
      {CATEGORIES.map(cat => (
        <button
          class={`filter-chip${cat === 'Todos' ? ' active' : ''}`}
          data-category={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Carousel -->
    <div class="carousel-outer">
      <button class="carousel-arrow prev" id="prevBtn" aria-label="Anterior" disabled>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>

      <div class="carousel-wrapper">
        <div class="carousel-track" id="carouselTrack">
          {videos.map(v => (
            <div class="video-card" data-categories={v.categories.join(',')}>
              <div class="video-type-badge">{v.badge}</div>
              <div
                class="video-thumb"
                data-video-id={v.id}
                onclick={`openVideosModal('${v.id}')`}
              >
                <img src={v.thumb} alt={v.title} loading="lazy" />
                <div class="video-overlay">
                  <div class="play-button">
                    <div class="play-icon"></div>
                  </div>
                </div>
              </div>
              <div class="video-info">
                <h3 class="video-title">{v.title}</h3>
                <div class="video-meta">
                  <div class="video-speaker">
                    <span class="speaker-dot"></span>
                    <span>{v.speaker}<br /><em>{v.role}</em></span>
                  </div>
                  <span class="video-duration">{v.duration}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <button class="carousel-arrow next" id="nextBtn" aria-label="Siguiente">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
    </div>

    <!-- Dots -->
    <div class="carousel-dots" id="carouselDots"></div>

  </div>

  <!-- Modal -->
  <div id="videosModal" class="video-modal">
    <div class="modal-backdrop" onclick="closeVideosModal()"></div>
    <div class="modal-content">
      <button class="modal-close" onclick="closeVideosModal()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
      <div class="modal-video-wrapper">
        <iframe id="videosModalIframe" src="" allowfullscreen
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share">
        </iframe>
      </div>
    </div>
  </div>
</section>

<style>
  /* ─── Section ─── */
  .videos-section {
    padding: var(--space-3xl) 0;
    background: var(--background);
  }

  .videos-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  /* ─── Header ─── */
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-sm);
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: var(--space-xs);
  }

  .badge-icon { font-size: 0.9rem; }

  .section-title {
    font: var(--font-h2);
    color: var(--text-primary);
    letter-spacing: -0.025em;
    margin: 0;
  }

  .title-gradient {
    background: linear-gradient(135deg, var(--primary-purple) 0%, var(--primary-blue) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-subtitle {
    font: var(--font-body-lg);
    color: var(--text-secondary);
    max-width: 480px;
    margin: 0;
    line-height: 1.7;
  }

  /* ─── Filter Bar ─── */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .filter-chip {
    padding: 0.4rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .filter-chip:hover {
    border-color: var(--primary-purple);
    color: var(--primary-purple);
  }

  .filter-chip.active {
    background: var(--primary-purple);
    border-color: var(--primary-purple);
    color: #fff;
  }

  /* ─── Carousel ─── */
  .carousel-outer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .carousel-wrapper {
    flex: 1;
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  /* ─── Card ─── */
  .video-card {
    flex: 0 0 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .video-type-badge {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    background: rgba(107, 232, 182, 0.1);
    border: 1px solid rgba(107, 232, 182, 0.25);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #6be8b6;
    width: fit-content;
  }

  .video-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
    cursor: pointer;
  }

  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    display: block;
  }

  .video-thumb:hover img {
    transform: scale(1.04);
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .video-thumb:hover .video-overlay {
    opacity: 1;
  }

  .play-button {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .video-thumb:hover .play-button {
    transform: scale(1.08);
  }

  .play-icon {
    width: 0;
    height: 0;
    border-left: 14px solid #463273;
    border-top: 9px solid transparent;
    border-bottom: 9px solid transparent;
    margin-left: 3px;
  }

  .video-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .video-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.4;
  }

  .video-meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .video-speaker {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    line-height: 1.4;
  }

  .speaker-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #6be8b6;
    flex-shrink: 0;
    margin-top: 0.35rem;
  }

  .video-speaker em {
    font-style: normal;
    color: var(--text-muted);
  }

  .video-duration {
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ─── Arrows ─── */
  .carousel-arrow {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .carousel-arrow:hover:not(:disabled) {
    border-color: var(--primary-purple);
    color: var(--primary-purple);
    background: var(--surface);
  }

  .carousel-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* ─── Dots ─── */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
  }

  .carousel-dots .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .carousel-dots .dot.active {
    background: var(--primary-purple);
    width: 18px;
    border-radius: 3px;
  }

  /* ─── Modal ─── */
  .video-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .video-modal.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    position: relative;
    width: 90%;
    max-width: 900px;
    aspect-ratio: 16/9;
    transform: scale(0.85);
    transition: transform 0.3s ease;
  }

  .video-modal.active .modal-content {
    transform: scale(1);
  }

  .modal-close {
    position: absolute;
    top: -44px;
    right: 0;
    background: rgba(255, 255, 255, 0.12);
    border: none;
    color: white;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }

  .modal-close:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  .modal-video-wrapper {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .modal-video-wrapper iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* ─── Responsive ─── */
  @media (max-width: 600px) {
    .carousel-arrow {
      display: none;
    }

    .filter-bar {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      padding-bottom: 0.25rem;
      scrollbar-width: none;
    }

    .filter-bar::-webkit-scrollbar { display: none; }

    .modal-close {
      top: 8px;
      right: 8px;
      background: rgba(0,0,0,0.6);
    }
  }
</style>

<script>
  // ─── State ───
  let activeCategory = 'Todos';
  let currentIndex = 0;
  let touchStartX = 0;
  let touchStartY = 0;

  // ─── Elements ───
  const track = document.getElementById('carouselTrack') as HTMLElement;
  const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement;
  const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement;
  const dotsContainer = document.getElementById('carouselDots') as HTMLElement;

  const wrapper = document.querySelector('.carousel-wrapper') as HTMLElement;
  const GAP = 24; // 1.5rem

  // ─── Helpers ───
  function getCardsPerView(): number {
    if (window.innerWidth >= 900) return 3;
    if (window.innerWidth >= 600) return 2;
    return 1;
  }

  function setCardWidths() {
    const perView = getCardsPerView();
    const wrapperW = wrapper.offsetWidth;
    const cardW = (wrapperW - GAP * (perView - 1)) / perView;
    track.querySelectorAll<HTMLElement>('.video-card').forEach(card => {
      card.style.width = `${cardW}px`;
      card.style.flexBasis = `${cardW}px`;
    });
  }

  function getVisibleCards(): HTMLElement[] {
    return [...track.querySelectorAll<HTMLElement>('.video-card')].filter(
      card => card.style.display !== 'none'
    );
  }

  function getMaxIndex(): number {
    return Math.max(0, getVisibleCards().length - getCardsPerView());
  }

  function getCardStep(): number {
    const first = getVisibleCards()[0];
    if (!first) return 0;
    return first.offsetWidth + GAP;
  }

  // ─── Render ───
  function applyFilter() {
    track.querySelectorAll<HTMLElement>('.video-card').forEach(card => {
      const cats = card.dataset.categories?.split(',') ?? [];
      const show = activeCategory === 'Todos' || cats.includes(activeCategory);
      card.style.display = show ? '' : 'none';
    });
  }

  function renderDots() {
    const visible = getVisibleCards();
    const perView = getCardsPerView();
    const total = Math.max(1, visible.length - perView + 1);
    dotsContainer.innerHTML = '';
    for (let i = 0; i < total; i++) {
      const dot = document.createElement('button');
      dot.className = 'dot' + (i === currentIndex ? ' active' : '');
      dot.setAttribute('aria-label', `Ir a ${i + 1}`);
      dot.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(dot);
    }
  }

  function updateButtons() {
    prevBtn.disabled = currentIndex === 0;
    nextBtn.disabled = currentIndex >= getMaxIndex();
  }

  function updateTranslate() {
    track.style.transform = `translateX(-${currentIndex * getCardStep()}px)`;
  }

  function goTo(index: number) {
    currentIndex = Math.max(0, Math.min(index, getMaxIndex()));
    updateTranslate();
    renderDots();
    updateButtons();
  }

  function refresh() {
    currentIndex = 0;
    applyFilter();
    requestAnimationFrame(() => {
      setCardWidths();
      updateTranslate();
      renderDots();
      updateButtons();
    });
  }

  // ─── Arrows ───
  prevBtn.addEventListener('click', () => goTo(currentIndex - 1));
  nextBtn.addEventListener('click', () => goTo(currentIndex + 1));

  // ─── Filter chips ───
  document.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-chip').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.dataset.category ?? 'Todos';
      refresh();
    });
  });

  // ─── Touch / swipe ───
  track.addEventListener('touchstart', (e: TouchEvent) => {
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
  }, { passive: true });

  track.addEventListener('touchend', (e: TouchEvent) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    const dy = e.changedTouches[0].clientY - touchStartY;
    if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) {
      goTo(currentIndex + (dx < 0 ? 1 : -1));
    }
  }, { passive: true });

  // ─── Resize ───
  window.addEventListener('resize', () => {
    setCardWidths();
    currentIndex = Math.min(currentIndex, getMaxIndex());
    updateTranslate();
    renderDots();
    updateButtons();
  });

  // ─── Init ───
  document.addEventListener('DOMContentLoaded', refresh);

  // ─── Modal ───
  function openVideosModal(videoId: string) {
    const modal = document.getElementById('videosModal')!;
    const iframe = document.getElementById('videosModalIframe') as HTMLIFrameElement;
    iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeVideosModal() {
    const modal = document.getElementById('videosModal')!;
    const iframe = document.getElementById('videosModalIframe') as HTMLIFrameElement;
    modal.classList.remove('active');
    iframe.src = '';
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') closeVideosModal();
  });

  (window as any).openVideosModal = openVideosModal;
  (window as any).closeVideosModal = closeVideosModal;
</script>
