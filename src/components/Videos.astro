---

<section class="videos-section">
  <div class="videos-container">

    <!-- Header -->
    <div class="section-header">
      <div class="section-badge">
        <span class="badge-icon">🎥</span>
        <span class="badge-text">Contenido exclusivo</span>
      </div>
      <h2 class="section-title">
        Aprende con <span class="title-gradient">expertos</span>
      </h2>
      <p class="section-subtitle">
        Charlas, webinars y workshops con líderes del ecosistema emprendedor
      </p>
    </div>

    <!-- Filter chips -->
    <div class="filter-bar">
      {CATEGORIES.map(cat => (
        <button
          class={`filter-chip${cat === 'Todos' ? ' active' : ''}`}
          data-category={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Carousel -->
    <div class="carousel-outer">
      <button class="carousel-arrow prev" id="prevBtn" aria-label="Anterior" disabled>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>

      <div class="carousel-wrapper">
        <div class="carousel-track" id="carouselTrack">
          {videos.map(v => (
            <div class="video-card" data-categories={v.categories.join(',')}>
              <div
                class="video-thumb"
                data-video-id={v.id}
              >
                <img src={v.thumb} alt={v.title} loading="lazy" />
                <!-- Categoría sobre la imagen -->
                <span class="cat-overlay">{v.categories[0]}</span>
                <div class="video-overlay">
                  <div class="play-button">
                    <div class="play-icon"></div>
                  </div>
                </div>
              </div>
              <div class="video-info">
                <h3 class="video-title">{v.title}</h3>
                <div class="video-author">
                  <span class="speaker-dot"></span>
                  <div class="author-details">
                    <span class="author-name">{v.speaker}</span>
                    <span class="author-role">{v.role}</span>
                  </div>
                </div>
                <div class="video-tags">
                  <span class="tag-badge">{v.badge}</span>
                  <span class="tag-sep">·</span>
                  <span class="tag-date">{v.date}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <button class="carousel-arrow next" id="nextBtn" aria-label="Siguiente">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
    </div>

    <!-- Dots -->
    <div class="carousel-dots" id="carouselDots"></div>

  </div>

</section>

<style>
  /* ─── Section ─── */
  .videos-section {
    padding: var(--space-3xl) 0;
    background: var(--background);
  }

  .videos-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  /* ─── Header ─── */
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-sm);
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: var(--space-xs);
  }

  .badge-icon { font-size: 0.9rem; }

  .section-title {
    font: var(--font-h2);
    color: var(--text-primary);
    letter-spacing: -0.025em;
    margin: 0;
  }

  .title-gradient {
    background: linear-gradient(135deg, var(--primary-purple) 0%, var(--primary-blue) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-subtitle {
    font: var(--font-body-lg);
    color: var(--text-secondary);
    max-width: 480px;
    margin: 0;
    line-height: 1.7;
  }

  /* ─── Filter Bar ─── */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .filter-chip {
    padding: 0.4rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .filter-chip:hover {
    border-color: var(--primary-purple);
    color: var(--primary-purple);
  }

  .filter-chip.active {
    background: var(--primary-purple);
    border-color: var(--primary-purple);
    color: #fff;
  }

  /* ─── Carousel ─── */
  .carousel-outer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .carousel-wrapper {
    flex: 1;
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  /* ─── Card ─── */
  .video-card {
    flex: 0 0 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Categoría encima de la imagen */
  .cat-overlay {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 2;
    padding: 0.25rem 0.7rem;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.02em;
    pointer-events: none;
  }

  /* Tipo sutil en el footer de la card */
  .video-type-subtle {
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ─── Card footer ─── */
  .video-author {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .author-name {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .author-role {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.3;
  }

  .video-tags {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.1rem;
  }

  .tag-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }

  .tag-sep {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .tag-date {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .video-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
    cursor: pointer;
  }

  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    display: block;
  }

  .video-thumb:hover img {
    transform: scale(1.04);
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .video-thumb:hover .video-overlay {
    opacity: 1;
  }

  .play-button {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .video-thumb:hover .play-button {
    transform: scale(1.08);
  }

  .play-icon {
    width: 0;
    height: 0;
    border-left: 14px solid #463273;
    border-top: 9px solid transparent;
    border-bottom: 9px solid transparent;
    margin-left: 3px;
  }

  .video-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .video-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.4;
  }

  .speaker-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #6be8b6;
    flex-shrink: 0;
    margin-top: 0.4rem;
  }

  /* ─── Arrows ─── */
  .carousel-arrow {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .carousel-arrow:hover:not(:disabled) {
    border-color: var(--primary-purple);
    color: var(--primary-purple);
    background: var(--surface);
  }

  .carousel-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* ─── Dots ─── */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
  }

  .carousel-dots .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .carousel-dots .dot.active {
    background: var(--primary-purple);
    width: 18px;
    border-radius: 3px;
  }

  /* ─── Responsive ─── */
  @media (max-width: 600px) {
    .carousel-arrow {
      display: none;
    }

    .filter-bar {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      padding-bottom: 0.25rem;
      scrollbar-width: none;
    }

    .filter-bar::-webkit-scrollbar { display: none; }
  }
</style>

<script>
  // ─── State ───
  let activeCategory = 'Todos';
  let currentIndex = 0;
  let touchStartX = 0;
  let touchStartY = 0;

  // ─── Elements ───
  const track = document.getElementById('carouselTrack') as HTMLElement;
  const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement;
  const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement;
  const dotsContainer = document.getElementById('carouselDots') as HTMLElement;

  const wrapper = document.querySelector('.carousel-wrapper') as HTMLElement;
  const GAP = 24; // 1.5rem

  // ─── Helpers ───
  function getCardsPerView(): number {
    if (window.innerWidth >= 900) return 3;
    if (window.innerWidth >= 600) return 2;
    return 1;
  }

  function setCardWidths() {
    const perView = getCardsPerView();
    const wrapperW = wrapper.offsetWidth;
    const cardW = (wrapperW - GAP * (perView - 1)) / perView;
    track.querySelectorAll<HTMLElement>('.video-card').forEach(card => {
      card.style.width = `${cardW}px`;
      card.style.flexBasis = `${cardW}px`;
    });
  }

  function getVisibleCards(): HTMLElement[] {
    return [...track.querySelectorAll<HTMLElement>('.video-card')].filter(
      card => card.style.display !== 'none'
    );
  }

  function getMaxIndex(): number {
    return Math.max(0, getVisibleCards().length - getCardsPerView());
  }

  function getCardStep(): number {
    const first = getVisibleCards()[0];
    if (!first) return 0;
    return first.offsetWidth + GAP;
  }

  // ─── Render ───
  function applyFilter() {
    track.querySelectorAll<HTMLElement>('.video-card').forEach(card => {
      const cats = card.dataset.categories?.split(',') ?? [];
      const show = activeCategory === 'Todos' || cats.includes(activeCategory);
      card.style.display = show ? '' : 'none';
    });
  }

  function renderDots() {
    const visible = getVisibleCards();
    const perView = getCardsPerView();
    const total = Math.max(1, visible.length - perView + 1);
    dotsContainer.innerHTML = '';
    for (let i = 0; i < total; i++) {
      const dot = document.createElement('button');
      dot.className = 'dot' + (i === currentIndex ? ' active' : '');
      dot.setAttribute('aria-label', `Ir a ${i + 1}`);
      dot.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(dot);
    }
  }

  function updateButtons() {
    prevBtn.disabled = currentIndex === 0;
    nextBtn.disabled = currentIndex >= getMaxIndex();
  }

  function updateTranslate() {
    track.style.transform = `translateX(-${currentIndex * getCardStep()}px)`;
  }

  function goTo(index: number) {
    currentIndex = Math.max(0, Math.min(index, getMaxIndex()));
    updateTranslate();
    renderDots();
    updateButtons();
  }

  function refresh() {
    currentIndex = 0;
    applyFilter();
    requestAnimationFrame(() => {
      setCardWidths();
      updateTranslate();
      renderDots();
      updateButtons();
    });
  }

  // ─── Arrows ───
  prevBtn.addEventListener('click', () => goTo(currentIndex - 1));
  nextBtn.addEventListener('click', () => goTo(currentIndex + 1));

  // ─── Filter chips ───
  document.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-chip').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.dataset.category ?? 'Todos';
      refresh();
    });
  });

  // ─── Touch / swipe ───
  track.addEventListener('touchstart', (e: TouchEvent) => {
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
  }, { passive: true });

  track.addEventListener('touchend', (e: TouchEvent) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    const dy = e.changedTouches[0].clientY - touchStartY;
    if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) {
      goTo(currentIndex + (dx < 0 ? 1 : -1));
    }
  }, { passive: true });

  // ─── Resize ───
  window.addEventListener('resize', () => {
    setCardWidths();
    currentIndex = Math.min(currentIndex, getMaxIndex());
    updateTranslate();
    renderDots();
    updateButtons();
  });

  // ─── Init ───
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', refresh);
  } else {
    refresh();
  }

  // Clicks en miniaturas de video → abrir en YouTube
  track.addEventListener('click', (e: MouseEvent) => {
    const thumb = (e.target as HTMLElement).closest<HTMLElement>('.video-thumb');
    if (thumb?.dataset.videoId) {
      window.open(`https://www.youtube.com/watch?v=${thumb.dataset.videoId}`, '_blank', 'noopener,noreferrer');
    }
  });
</script>
