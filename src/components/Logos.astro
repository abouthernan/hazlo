---
const logos = [
  { src: '/logos/bubble.png',      alt: 'Bubble' },
  { src: '/logos/chat-gpt.png',    alt: 'ChatGPT' },
  { src: '/logos/n8n.png',         alt: 'n8n' },
  { src: '/logos/claude-text.png', alt: 'Claude' },
  { src: '/logos/shopify.png',     alt: 'Shopify' },
  { src: '/logos/gemini-text.png', alt: 'Gemini' },
  { src: '/logos/hotjar.png',      alt: 'Hotjar' },
  { src: '/logos/lovable-text.png',alt: 'Lovable' },
  { src: '/logos/antigravity_product_lockup_full_color_reverse.png', alt: 'Antigravity' },
];
---

<section class="logos-section">
  <div class="logos-inner">
    <div class="fade fade-left"></div>
    <div class="fade fade-right"></div>

    <div class="logos-track">
      {logos.map(logo => (
        <div class="logo-item">
          <img src={logo.src} alt={logo.alt} loading="lazy" />
        </div>
      ))}
      {logos.map(logo => (
        <div class="logo-item" aria-hidden="true">
          <img src={logo.src} alt="" loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .logos-section {
    padding: var(--space-xl) 0;
  }

  /* Desktop: box centrado con márgenes; Mobile: ancho completo */
  .logos-inner {
    position: relative;
    overflow: hidden;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-2xl);
  }

  @media (max-width: 768px) {
    .logos-inner {
      padding: 0;
    }
  }

  /* Fades */
  .fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100px;
    z-index: 2;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .fade { width: 48px; }
  }

  .fade-left {
    left: 0;
    background: linear-gradient(to right, var(--background), transparent);
  }

  .fade-right {
    right: 0;
    background: linear-gradient(to left, var(--background), transparent);
  }

  /* Track — sin transform estático para no romper el loop */
  .logos-track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
    animation: scroll-logos 24s linear -4s infinite;
  }

  @media (max-width: 768px) {
    .logos-track {
      animation-duration: 14s;
      animation-delay: -5s;
    }
  }

  @keyframes scroll-logos {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 40px;
    margin-right: 3rem;
  }

  @media (max-width: 768px) {
    .logo-item {
      margin-right: 4rem;
    }
  }

  .logo-item img {
    height: 100%;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    filter: grayscale(100%) brightness(0.6);
    opacity: 0.7;
    transition: opacity 0.2s ease, filter 0.2s ease;
  }

  .logo-item img:hover {
    opacity: 1;
    filter: grayscale(100%) brightness(0.9);
  }
</style>
