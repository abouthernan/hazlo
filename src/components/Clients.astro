---
// Intercalados: logos compactos (~2.5:1) con logos muy anchos (>3:1)
const clients = [
  { src: '/clientes/acofacli.png',                alt: 'Acofacli' },
  { src: '/clientes/azzorti.png',                 alt: 'Azzorti' },
  { src: '/clientes/clario-hotel.png',            alt: 'Clario Hotel' },
  { src: '/clientes/clligan.png',                 alt: 'Clligan' },
  { src: '/clientes/isarte.png',                  alt: 'Isarte' },
  { src: '/clientes/native-root-coffee.png',      alt: 'Native Root Coffee' },
  { src: '/clientes/jestar.png',                  alt: 'Jestar' },
  { src: '/clientes/purezza.png',                 alt: 'Purezza' },
  { src: '/clientes/mas-education.png',           alt: 'Más Education' },
  { src: '/clientes/multiobras-panama.png',       alt: 'Multiobras Panamá' },
  { src: '/clientes/pardo.png',                   alt: 'Pardo' },
  { src: '/clientes/perez-lara.png',              alt: 'Pérez Lara' },
  { src: '/clientes/rancho-santa-rosa.png',       alt: 'Rancho Santa Rosa' },
  { src: '/clientes/union-de-contadores.png',     alt: 'Unión de Contadores' },
  { src: '/clientes/alvarez-lievano-laserna.png', alt: 'Álvarez Liévano Laserna' },
];
---

<section class="clients-section">
  <div class="clients-inner">
    <div class="fade fade-left"></div>
    <div class="fade fade-right"></div>

    <div class="clients-track">
      {clients.map(c => (
        <div class="client-item">
          <img src={c.src} alt={c.alt} loading="lazy" />
        </div>
      ))}
      {clients.map(c => (
        <div class="client-item" aria-hidden="true">
          <img src={c.src} alt="" loading="lazy" />
        </div>
      ))}
    </div>
  </div>

  <p class="clients-label">Algunos de nuestros clientes</p>
</section>

<style>
  .clients-section {
    padding: 0 0 var(--space-lg);
    margin-top: calc(-1 * var(--space-lg));
  }

  /* Desktop: box centrado con márgenes; Mobile: ancho completo */
  .clients-inner {
    position: relative;
    overflow: hidden;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-2xl);
  }

  @media (max-width: 768px) {
    .clients-inner {
      padding: 0;
    }
  }

  .clients-label {
    text-align: center;
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: var(--space-xl);
    margin-bottom: 0;
  }

  /* Fades */
  .fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100px;
    z-index: 2;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .fade { width: 48px; }
  }

  .fade-left {
    left: 0;
    background: linear-gradient(to right, var(--background), transparent);
  }

  .fade-right {
    right: 0;
    background: linear-gradient(to left, var(--background), transparent);
  }

  /* Track — sin transform estático para no romper el loop */
  .clients-track {
    display: flex;
    align-items: center;
    width: max-content;
    padding: 1rem 0;
    will-change: transform;
    animation: scroll-clients 60s linear infinite;
  }

  @media (max-width: 768px) {
    .clients-track {
      animation-duration: 30s;
    }
  }

  @keyframes scroll-clients {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .client-item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-right: 3rem;
  }

  @media (max-width: 768px) {
    .client-item {
      margin-right: 4rem;
    }
  }

  .client-item img {
    height: 48px;
    width: auto;
    object-fit: contain;
    filter: grayscale(100%) brightness(0.65);
    opacity: 0.75;
    transition: opacity 0.2s ease, filter 0.2s ease;
  }

  .client-item img:hover {
    opacity: 1;
    filter: grayscale(100%) brightness(0.95);
  }
</style>
