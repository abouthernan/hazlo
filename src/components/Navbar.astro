---
// src/components/Navbar.astro
---

<nav class="navbar">
  <div class="navbar-container">

    <!-- Nav izquierda (desktop) -->
    <div class="navbar-nav navbar-nav-left">
      <a href="https://wa.me/573133846633" target="_blank" rel="noopener noreferrer" class="nav-link">Empresas</a>
      <a href="#aprende" class="nav-link">Aprende</a>
      <a href="#recursos" class="nav-link">Recursos</a>
    </div>

    <!-- Logo centrado -->
    <div class="navbar-brand">
      <a href="/" class="brand-link">
        <img src="/logo/logo-mobile.png" alt="Hazlo Logo" class="logo-container" />
      </a>
    </div>

    <!-- Nav derecha (desktop) + acciones -->
    <div class="navbar-nav navbar-nav-right">
      <a href="#clases" class="nav-link">Clases</a>
      <a href="#programas" class="nav-link">Programas</a>
      <a href="https://chat.whatsapp.com/KDSfG6NQcyK0hLDo2NpKbh?mode=ems_copy_t" class="nav-link">Comunidad</a>

      <!-- Mobile Menu Toggle -->
      <button class="mobile-menu-toggle" onclick="toggleMobileMenu()" aria-label="Abrir menú">
        <svg class="icon-menu" width="28" height="20" viewBox="0 0 28 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line x1="0" y1="3" x2="28" y2="3" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="10" y1="15" x2="28" y2="15" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="20" y1="4" x2="4" y2="20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu-content">
      <a href="#comunidad" class="mobile-nav-link">Comunidad</a>
      <a href="https://wa.me/573133846633" target="_blank" rel="noopener noreferrer" class="mobile-nav-link">Empresas</a>
      <a href="#aprende" class="mobile-nav-link">Aprende</a>
      <a href="#recursos" class="mobile-nav-link">Recursos</a>
      <a href="#clases" class="mobile-nav-link">Clases</a>
      <a href="#programas" class="mobile-nav-link">Programas</a>
    </div>
  </div>
</nav>

<script>
  // Función para toggle del menú móvil
  function toggleMobileMenu() {
    const mobileMenu = document.getElementById('mobileMenu');
    const toggle = document.querySelector('.mobile-menu-toggle');
    
    if (mobileMenu && toggle) {
      mobileMenu.classList.toggle('active');
      toggle.classList.toggle('active');
    }
  }

  // Cerrar menú móvil al hacer clic en un enlace
  document.addEventListener('DOMContentLoaded', () => {
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        const mobileMenu = document.getElementById('mobileMenu');
        const toggle = document.querySelector('.mobile-menu-toggle');
        if (mobileMenu && toggle) {
          mobileMenu.classList.remove('active');
          toggle.classList.remove('active');
        }
      });
    });
  });

  // Hacer función global
  (window as any).toggleMobileMenu = toggleMobileMenu;
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 1);
    backdrop-filter: blur(12px);
    border-bottom: 0px solid var(--border-light);
    transition: var(--transition);
  }

  .logo-container {
    height: 2.75rem;
    width: auto;
    display: block;
  }



  /* Aseguramos que el selector de dark mode tenga mayor especificidad */
  html[data-theme="dark"] .navbar {
    background: rgba(15, 23, 42, 0.9) !important;
    border-bottom-color: var(--border);
  }

  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-md);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 4rem;
  }

  /* Brand centrado */
  .navbar-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 2.5rem;
  }

  .brand-link {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  /* Navigation Links */
  .navbar-nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .navbar-nav-left {
    justify-content: flex-end;
  }

  .navbar-nav-right {
    justify-content: flex-start;
  }

  .nav-link {
    text-decoration: none;
    color: var(--text-secondary);
    font-weight: 500;
    transition: var(--transition);
    position: relative;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(135deg, var(--primary-purple) 0%, var(--primary-blue) 100%);
    transition: var(--transition);
  }

  .nav-link:hover::after {
    width: 100%;
  }


  .theme-toggle {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-primary);
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .theme-toggle:hover {
    background: var(--surface-hover);
    transform: scale(1.05);
  }

  /* Mobile Menu Toggle */
  .mobile-menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .icon-menu,
  .icon-close {
    color: var(--text-primary);
    display: block;
    transition: opacity 0.2s ease;
  }

  .icon-close {
    display: none;
  }

  /* Estado activo → mostrar X, ocultar menú */
  .mobile-menu-toggle.active .icon-menu {
    display: none;
  }

  .mobile-menu-toggle.active .icon-close {
    display: block;
  }

  /* Mobile Menu */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-light);
    transform: translateY(-100%);
    opacity: 0;
    visibility: hidden;
    transition: var(--transition);
  }

  html[data-theme="dark"] .mobile-menu {
    background: rgba(15, 23, 42, 0.95) !important;
    border-bottom-color: var(--border);
  }

  .mobile-menu.active {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu-content {
    padding: var(--space-lg) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .mobile-nav-link {
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 500;
    font-size: 1.1rem;
    padding: var(--space-sm) 0;
    transition: var(--transition);
    border-bottom: 1px solid var(--border-light);
  }

  .mobile-nav-link:hover {
    color: var(--primary-purple);
  }

  .mobile-nav-link:last-of-type {
    border-bottom: none;
  }

  .mobile-actions {
    margin-top: var(--space-sm);
  }

  .mobile-cta {
    width: 100%;
    justify-content: center;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .navbar-container {
      padding: 0 var(--space-sm);
      display: flex;
      justify-content: flex-end;
      position: relative;
    }

    /* Ocultar nav izquierda */
    .navbar-nav-left {
      display: none;
    }

    /* Logo centrado absolutamente en el navbar */
    .navbar-brand {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      padding: 0;
    }

    /* Nav derecha: ocultar links, mostrar solo toggle */
    .navbar-nav-right .nav-link {
      display: none;
    }

    .navbar-nav-right {
      justify-content: flex-end;
    }

    .mobile-menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  /* Scroll effect */
  .navbar.scrolled {
    background: rgba(255, 255, 255, 0.97);
    box-shadow: var(--shadow);
  }

  html[data-theme="dark"] .navbar.scrolled {
    background: rgba(15, 23, 42, 0.97) !important;
  }
</style>

<script>
  // Efecto de scroll para el navbar
  document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.querySelector('.navbar');
    
    function handleScroll() {
      if (navbar) {
        if (window.scrollY > 50) {
          navbar.classList.add('scrolled');
        } else {
          navbar.classList.remove('scrolled');
        }
      }
    }

    window.addEventListener('scroll', handleScroll);
  });
</script>