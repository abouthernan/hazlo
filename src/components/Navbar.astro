---
// src/components/Navbar.astro
---

<nav class="navbar">
  <div class="navbar-container">

    <!-- Nav izquierda (desktop) -->
    <div class="navbar-nav navbar-nav-left">
      <a href="https://wa.me/573133846633" target="_blank" rel="noopener noreferrer" class="nav-link">Empresas</a>
      <a href="/#aprende" class="nav-link">Aprende</a>
      <a href="/recursos" class="nav-link">Recursos</a>
    </div>

    <!-- Logo centrado -->
    <div class="navbar-brand">
      <a href="/" class="brand-link">
        <img src="/logo/logo-mobile.png" alt="Hazlo Logo" class="logo-container" />
      </a>
    </div>

    <!-- Nav derecha (desktop) + acciones -->
    <div class="navbar-nav navbar-nav-right">
      <a href="/clases" class="nav-link">Clases</a>

      <!-- Programas con megamenu -->
      <div class="nav-item has-megamenu" id="programasItem">
        <button class="nav-link nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false" id="programasTrigger">
          Programas
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>

        <div class="megamenu" id="megamenu" role="region" aria-label="Programas">
          <div class="megamenu-inner">

            <a href="/claude" class="mega-card">
              <div class="mega-card-icon">🤖</div>
              <div class="mega-card-body">
                <div class="mega-card-badge">Formación</div>
                <h3 class="mega-card-title">Claude para Profesionales</h3>
                <p class="mega-card-desc">Dominá la IA más avanzada en 8 semanas. Prompting, agentes, MCPs y automatizaciones reales.</p>
                <span class="mega-card-cta">
                  Ver programa
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </a>

            <a href="/mvp" class="mega-card">
              <div class="mega-card-icon">🚀</div>
              <div class="mega-card-body">
                <div class="mega-card-badge">Emprendimiento</div>
                <h3 class="mega-card-title">De 0 a MVP en 8 Semanas</h3>
                <p class="mega-card-desc">Construí, validá y lanzá tu producto sin perder tiempo ni dinero. Método probado para founders.</p>
                <span class="mega-card-cta">
                  Ver programa
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </a>

          </div>
        </div>
      </div>

      <a href="https://chat.whatsapp.com/KDSfG6NQcyK0hLDo2NpKbh?mode=ems_copy_t" class="nav-link">Comunidad</a>

      <!-- Mobile Menu Toggle -->
      <button class="mobile-menu-toggle" onclick="toggleMobileMenu()" aria-label="Abrir menú">
        <svg class="icon-menu" width="28" height="20" viewBox="0 0 28 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line x1="0" y1="3" x2="28" y2="3" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="10" y1="15" x2="28" y2="15" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="20" y1="4" x2="4" y2="20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu-content">
      <a href="#comunidad" class="mobile-nav-link">Comunidad</a>
      <a href="https://wa.me/573133846633" target="_blank" rel="noopener noreferrer" class="mobile-nav-link">Empresas</a>
      <a href="/#aprende" class="mobile-nav-link">Aprende</a>
      <a href="/recursos" class="mobile-nav-link">Recursos</a>
      <a href="/clases" class="mobile-nav-link">Clases</a>
      <div class="mobile-nav-group">
        <span class="mobile-nav-group-label">Programas</span>
        <a href="/claude" class="mobile-nav-link mobile-nav-sub">🤖 Claude para Profesionales</a>
        <a href="/mvp" class="mobile-nav-link mobile-nav-sub">🚀 De 0 a MVP en 8 Semanas</a>
      </div>
    </div>
  </div>
</nav>

<script>
  function toggleMobileMenu() {
    const mobileMenu = document.getElementById('mobileMenu');
    const toggle = document.querySelector('.mobile-menu-toggle');
    if (mobileMenu && toggle) {
      mobileMenu.classList.toggle('active');
      toggle.classList.toggle('active');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Cerrar menú móvil al hacer clic en un enlace
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        const mobileMenu = document.getElementById('mobileMenu');
        const toggle = document.querySelector('.mobile-menu-toggle');
        if (mobileMenu && toggle) {
          mobileMenu.classList.remove('active');
          toggle.classList.remove('active');
        }
      });
    });

    // Megamenu: hover con delay para evitar parpadeo
    const item = document.getElementById('programasItem');
    const trigger = document.getElementById('programasTrigger');
    const megamenu = document.getElementById('megamenu');
    if (!item || !trigger || !megamenu) return;

    let closeTimeout: ReturnType<typeof setTimeout>;

    function openMenu() {
      clearTimeout(closeTimeout);
      item.classList.add('open');
      trigger.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      closeTimeout = setTimeout(() => {
        item.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
      }, 120);
    }

    item.addEventListener('mouseenter', openMenu);
    item.addEventListener('mouseleave', closeMenu);
    trigger.addEventListener('focus', openMenu);

    // Cerrar al hacer Tab fuera del megamenu
    megamenu.addEventListener('focusout', (e) => {
      if (!item.contains((e as FocusEvent).relatedTarget as Node)) closeMenu();
    });

    // Cerrar con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        item.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.focus();
      }
    });

    // Cerrar al hacer clic en un enlace del megamenu
    megamenu.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => item.classList.remove('open'));
    });
  });

  (window as any).toggleMobileMenu = toggleMobileMenu;
</script>

<style>
  .navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 1);
    backdrop-filter: blur(12px);
    border-bottom: 0px solid var(--border-light);
    transition: var(--transition);
  }

  .logo-container {
    height: 2.75rem;
    width: auto;
    display: block;
  }

  html[data-theme="dark"] .navbar {
    background: rgba(15, 23, 42, 0.9) !important;
    border-bottom-color: var(--border);
  }

  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-md);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 4rem;
  }

  .navbar-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 2.5rem;
  }

  .brand-link {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .navbar-nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .navbar-nav-left  { justify-content: flex-end; }
  .navbar-nav-right { justify-content: flex-start; }

  .nav-link {
    text-decoration: none;
    color: var(--text-secondary);
    font-weight: 500;
    transition: var(--transition);
    position: relative;
  }

  .nav-link:hover { color: var(--text-primary); }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px; left: 0;
    width: 0; height: 2px;
    background: linear-gradient(135deg, var(--primary-purple) 0%, var(--primary-blue) 100%);
    transition: var(--transition);
  }

  .nav-link:hover::after { width: 100%; }

  /* ── Megamenu trigger ── */
  .nav-item {
    position: relative;
  }

  .nav-dropdown-trigger {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-family);
    font-size: inherit;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0;
  }

  /* quitar el ::after del trigger (lo hereda de .nav-link) */
  .nav-dropdown-trigger::after {
    bottom: -4px;
  }

  .dropdown-chevron {
    transition: transform 0.25s ease;
    flex-shrink: 0;
    color: var(--text-muted);
    margin-top: 1px;
  }

  .has-megamenu.open .dropdown-chevron {
    transform: rotate(180deg);
  }

  /* ── Megamenu panel ── */
  .megamenu {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    width: 520px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 40px -8px rgba(0,0,0,0.15), 0 0 0 1px rgba(177,152,233,0.1);
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 200;
  }

  /* pequeña flecha decorativa */
  .megamenu::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 12px; height: 12px;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  .has-megamenu.open .megamenu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .megamenu-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  /* ── Cards del megamenu ── */
  .mega-card {
    display: flex;
    gap: 0.875rem;
    padding: 1rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    text-decoration: none;
    transition: var(--transition);
    background: var(--background);
  }

  .mega-card:hover {
    border-color: rgba(177,152,233,0.4);
    background: var(--surface);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .mega-card-icon {
    font-size: 1.75rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .mega-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .mega-card-badge {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary-purple);
    background: rgba(177,152,233,0.12);
    border: 1px solid rgba(177,152,233,0.25);
    border-radius: 50px;
    padding: 0.15rem 0.5rem;
    width: fit-content;
  }

  .mega-card-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0;
  }

  .mega-card-desc {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .mega-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--primary-purple);
    margin-top: 0.25rem;
    transition: gap 0.15s ease;
  }

  .mega-card:hover .mega-card-cta {
    gap: 6px;
  }

  /* ── Theme toggle ── */
  .theme-toggle {
    width: 2.5rem; height: 2.5rem;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-primary);
    cursor: pointer;
    transition: var(--transition);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem;
  }

  .theme-toggle:hover { background: var(--surface-hover); transform: scale(1.05); }

  /* ── Mobile toggle ── */
  .mobile-menu-toggle {
    display: none;
    align-items: center; justify-content: center;
    width: 3rem; height: 3rem;
    background: none; border: none; cursor: pointer; padding: 0;
  }

  .icon-menu, .icon-close {
    color: var(--text-primary);
    display: block;
    transition: opacity 0.2s ease;
  }

  .icon-close { display: none; }

  .mobile-menu-toggle.active .icon-menu  { display: none; }
  .mobile-menu-toggle.active .icon-close { display: block; }

  /* ── Mobile menu ── */
  .mobile-menu {
    position: absolute;
    top: 100%; left: 0; right: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-light);
    transform: translateY(-100%);
    opacity: 0; visibility: hidden;
    transition: var(--transition);
  }

  html[data-theme="dark"] .mobile-menu {
    background: rgba(15, 23, 42, 0.95) !important;
    border-bottom-color: var(--border);
  }

  .mobile-menu.active {
    transform: translateY(0);
    opacity: 1; visibility: visible;
  }

  .mobile-menu-content {
    padding: var(--space-lg) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .mobile-nav-link {
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 500;
    font-size: 1.1rem;
    padding: var(--space-sm) 0;
    transition: var(--transition);
    border-bottom: 1px solid var(--border-light);
  }

  .mobile-nav-link:hover { color: var(--primary-purple); }
  .mobile-nav-link:last-of-type { border-bottom: none; }

  .mobile-nav-group {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-bottom: 1px solid var(--border-light);
    padding-bottom: var(--space-sm);
  }

  .mobile-nav-group-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: var(--space-sm) 0 0.4rem;
  }

  .mobile-nav-sub {
    font-size: 0.975rem;
    padding: 0.5rem 0;
    border-bottom: none;
    color: var(--text-secondary);
  }

  .mobile-nav-sub:hover { color: var(--primary-purple); }

  .mobile-actions { margin-top: var(--space-sm); }
  .mobile-cta { width: 100%; justify-content: center; }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .navbar-container {
      padding: 0 var(--space-sm);
      display: flex;
      justify-content: flex-end;
      position: relative;
    }

    .navbar-nav-left { display: none; }

    .navbar-brand {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      padding: 0;
    }

    .navbar-nav-right .nav-link,
    .navbar-nav-right .nav-item { display: none; }

    .navbar-nav-right { justify-content: flex-end; }

    .mobile-menu-toggle {
      display: flex;
      align-items: center; justify-content: center;
    }
  }

  /* ── Scroll effect ── */
  .navbar.scrolled {
    background: rgba(255, 255, 255, 0.97);
    box-shadow: var(--shadow);
  }

  html[data-theme="dark"] .navbar.scrolled {
    background: rgba(15, 23, 42, 0.97) !important;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.querySelector('.navbar');
    window.addEventListener('scroll', () => {
      if (navbar) navbar.classList.toggle('scrolled', window.scrollY > 50);
    });
  });
</script>
