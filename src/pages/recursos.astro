---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Copyright from '../components/Copyright.astro';

const recursos = [
  {
    slug: 'tokens-claude',
    title: 'Deja de desperdiciar tokens en Claude',
    description: 'Guía práctica con tips para manejar archivos, gestionar el contexto y escribir prompts más eficientes. Ahorra tokens y obtén mejores resultados.',
    badge: 'Tips',
    topic: 'Claude',
    categories: ['Claude'],
    href: '/recursos/tokens-claude.html',
    external: false,
  },
  {
    slug: 'geo-ia',
    title: 'GEO: cómo aparecer en ChatGPT, Claude y Gemini',
    description: 'Guía de Generative Engine Optimization: estrategias para que tu marca sea citada y recomendada por los principales asistentes de IA.',
    badge: 'Guía',
    topic: 'IA',
    categories: ['IA'],
    href: '/recursos/geo-ia.html',
    external: false,
  },
  {
    slug: 'template-agente-leads',
    title: 'Template: agente de calificación de leads',
    description: 'Plantilla lista para usar: construye paso a paso un agente de IA que califica prospectos, hace preguntas clave y entrega resúmenes automáticos.',
    badge: 'Template',
    topic: 'Automatización',
    categories: ['IA', 'Automatización'],
    href: '/recursos/template-agente-leads.html',
    external: false,
  },
];

const CATEGORIES = ['Todos', 'Claude', 'IA', 'Automatización'];
---

<Layout
  title="Recursos — Hazlo"
  description="Guías, webinars y materiales prácticos para emprendedores que quieren usar IA de forma real."
>
  <Navbar />

  <main class="recursos-main">
    <!-- HERO -->
    <section class="recursos-hero">
      <div class="container">
        <div class="recursos-hero-inner">
          <div class="prog-badge">
            <span class="badge-dot"></span>
            <span>Hazlo · Recursos</span>
          </div>
          <h1 class="recursos-title">
            Aprende con <span class="title-gradient">recursos</span> prácticos
          </h1>
          <p class="recursos-subtitle">
            Guías, webinars y materiales para que uses IA de forma real en tu trabajo o negocio.
          </p>
        </div>
      </div>
    </section>

    <!-- CATEGORÍAS -->
    <section class="recursos-grid-section">
      <div class="container">
        <div class="filter-bar">
          {CATEGORIES.map(cat => (
            <button class={`filter-chip${cat === 'Todos' ? ' active' : ''}`} data-category={cat}>
              {cat}
            </button>
          ))}
        </div>

        <div class="recursos-grid" id="recursosGrid">
          {recursos.map((r) => (
            r.comingSoon ? (
              <div class="recurso-card recurso-card-soon" data-categories={r.categories.join(',')}>
                <div class="recurso-thumb">
                  <div class="recurso-thumb-bg">
                    <span class="recurso-thumb-title">{r.title}</span>
                  </div>
                  <span class="recurso-badge">{r.badge}</span>
                  <span class="recurso-soon-pill">Próximamente</span>
                </div>
                <div class="recurso-info">
                  <span class="recurso-topic">{r.topic}</span>
                  <h3 class="recurso-title">{r.title}</h3>
                  <p class="recurso-desc">{r.description}</p>
                  <div class="recurso-actions">
                    <span class="recurso-cta recurso-cta-muted">En preparación</span>
                    <div class="recurso-cats">
                      {r.categories.map(cat => (
                        <span class="cat-pill">{cat}</span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={r.href}
                target={r.external ? '_blank' : '_self'}
                rel={r.external ? 'noopener noreferrer' : undefined}
                class="recurso-card"
                data-categories={r.categories.join(',')}
              >
                <div class="recurso-thumb">
                  <div class="recurso-thumb-bg">
                    <span class="recurso-thumb-title">{r.title}</span>
                  </div>
                  <span class="recurso-badge">{r.badge}</span>
                </div>
                <div class="recurso-info">
                  <span class="recurso-topic">{r.topic}</span>
                  <h3 class="recurso-title">{r.title}</h3>
                  <p class="recurso-desc">{r.description}</p>
                  <div class="recurso-actions">
                    <span class="recurso-cta recurso-cta-primary">
                      <span>{r.external ? 'Ver webinar' : 'Ver recurso'}</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </span>
                    <div class="recurso-cats">
                      {r.categories.map(cat => (
                        <span class="cat-pill">{cat}</span>
                      ))}
                    </div>
                  </div>
                </div>
              </a>
            )
          ))}
        </div>

        <p class="recursos-empty" id="recursosEmpty" style="display:none">
          No hay recursos en esta categoría aún. ¡Pronto habrá más!
        </p>
      </div>
    </section>
  </main>

  <Footer />
  <Copyright />
</Layout>

<style>
  .recursos-main {
    padding-top: 4rem;
  }

  /* ── HERO ── */
  .recursos-hero {
    padding: 5rem 0 3rem;
    text-align: center;
  }

  .recursos-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .prog-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    border-radius: 100px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary-purple);
  }

  .recursos-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--text-primary);
  }

  .title-gradient {
    background: linear-gradient(135deg, var(--primary-purple) 0%, var(--primary-blue) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .recursos-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 520px;
    line-height: 1.65;
  }

  /* ── FILTER BAR ── */
  .recursos-grid-section {
    padding: 0 0 6rem;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 1rem;
    border-radius: 100px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .filter-chip:hover {
    border-color: var(--primary-purple);
    color: var(--text-primary);
  }

  .filter-chip.active {
    background: var(--primary-purple);
    border-color: var(--primary-purple);
    color: #fff;
  }

  /* ── GRID ── */
  .recursos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .recursos-empty {
    text-align: center;
    color: var(--text-secondary);
    padding: 3rem 0;
    font-size: 0.95rem;
  }

  /* ── CARD ── */
  .recurso-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .recurso-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.18);
    border-color: var(--primary-purple);
  }

  /* Thumbnail */
  .recurso-thumb {
    position: relative;
    aspect-ratio: 16/9;
    background: linear-gradient(135deg, #1a0e38 0%, #251848 60%, #2D1E55 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .recurso-thumb-bg {
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .recurso-thumb-title {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    text-align: center;
    line-height: 1.3;
    max-width: 220px;
  }

  .recurso-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: rgba(46, 232, 182, 0.15);
    border: 1px solid rgba(46, 232, 182, 0.3);
    color: #2EE8B6;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
  }

  /* Info */
  .recurso-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .recurso-topic {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary-purple);
  }

  .recurso-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .recurso-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
  }

  .recurso-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .recurso-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 100px;
    padding: 0.4rem 0.85rem;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: gap 0.2s ease;
  }

  .recurso-cta-primary {
    background: var(--primary-purple);
    color: #fff;
  }

  .recurso-card:hover .recurso-cta-primary {
    gap: 0.6rem;
  }

  /* Category pills on card */
  .recurso-cats {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .cat-pill {
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 100px;
    background: rgba(177,152,233,0.1);
    border: 1px solid rgba(177,152,233,0.2);
    color: var(--primary-purple);
  }

  /* Coming soon */
  .recurso-card-soon {
    opacity: 0.65;
    cursor: default;
    pointer-events: none;
  }

  .recurso-soon-pill {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.6);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.22rem 0.6rem;
    border-radius: 100px;
  }

  .recurso-cta-muted {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 100px;
    padding: 0.4rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .recursos-hero {
      padding: 3.5rem 0 2rem;
    }
    .recursos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const cards = document.querySelectorAll<HTMLElement>('.recurso-card');
  const empty = document.getElementById('recursosEmpty');

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      const cat = chip.dataset.category ?? 'Todos';
      let visible = 0;
      cards.forEach(card => {
        const cats = card.dataset.categories?.split(',') ?? [];
        const show = cat === 'Todos' || cats.includes(cat);
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
    });
  });
</script>
