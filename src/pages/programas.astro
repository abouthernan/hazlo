---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Copyright from "../components/Copyright.astro";
---

<Layout
  title="Claude para Profesionales — Programa de Formación · Hazlo"
  description="El programa definitivo para aprender Claude desde cero hasta nivel experto. 8 módulos, 16 sesiones en vivo, $270 USD."
>
  <Navbar />

  <!-- ─── HERO ─── -->
  <section class="prog-hero">
    <div class="container">
      <div class="prog-hero-inner">
        <div class="prog-badge">
          <span class="badge-dot"></span>
          <span>Programa Principal · Hazlo</span>
        </div>

        <h1 class="prog-hero-title">
          Claude para <span class="title-gradient">Profesionales</span>
        </h1>

        <p class="prog-hero-subtitle">
          Aprende a usar Claude de forma profesional: desde los fundamentos hasta
          construir agentes, automatizaciones y flujos de trabajo reales.
          Clases en vivo, con comunidad y proyectos aplicados.
        </p>

        <div class="prog-hero-actions">
          <a href="#registro" class="btn btn-primary prog-cta">
            <span>Reservar mi lugar</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="#programa" class="btn btn-secondary prog-cta-sec">
            Ver programa completo
          </a>
        </div>

        <!-- Mini stats -->
        <div class="prog-hero-stats">
          <div class="prog-stat">
            <span class="prog-stat-num">8</span>
            <span class="prog-stat-label">Módulos</span>
          </div>
          <div class="prog-stat-div"></div>
          <div class="prog-stat">
            <span class="prog-stat-num">16</span>
            <span class="prog-stat-label">Sesiones en vivo</span>
          </div>
          <div class="prog-stat-div"></div>
          <div class="prog-stat">
            <span class="prog-stat-num">$270</span>
            <span class="prog-stat-label">USD · Precio especial</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── PARA QUIÉN ─── -->
  <section class="prog-section">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="badge-icon">🎯</span>
          <span class="badge-text">¿Para quién es?</span>
        </div>
        <h2 class="section-title">
          Este programa es para <span class="title-gradient">ti</span>
        </h2>
        <p class="section-subtitle">
          No importa tu nivel técnico. Si quieres usar IA de forma real en tu trabajo o negocio, este es tu programa.
        </p>
      </div>

      <div class="persona-grid">
        <div class="persona-card">
          <div class="persona-icon">🚀</div>
          <h3>Emprendedores</h3>
          <p>Quieres automatizar tareas, crear contenido y tomar mejores decisiones con IA sin depender de un equipo técnico.</p>
        </div>
        <div class="persona-card">
          <div class="persona-icon">💼</div>
          <h3>Profesionales</h3>
          <p>Buscas aumentar tu productividad, mejorar la calidad de tu trabajo y diferenciarte en tu industria con IA.</p>
        </div>
        <div class="persona-card">
          <div class="persona-icon">🏢</div>
          <h3>Equipos de empresas</h3>
          <p>Tu empresa quiere adoptar IA de forma práctica. Necesitan un programa estructurado y aplicable desde el día uno.</p>
        </div>
        <div class="persona-card">
          <div class="persona-icon">⚡</div>
          <h3>Builders y creadores</h3>
          <p>Ya usas herramientas de IA pero quieres ir más profundo: agentes, MCPs, APIs y automatizaciones avanzadas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── PROGRAMA / CURRICULUM ─── -->
  <section class="prog-section prog-section-alt" id="programa">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="badge-icon">📚</span>
          <span class="badge-text">Programa completo</span>
        </div>
        <h2 class="section-title">
          8 módulos, de <span class="title-gradient">cero a experto</span>
        </h2>
        <p class="section-subtitle">
          Cada módulo tiene 2 sesiones en vivo. Avanzas paso a paso con proyectos reales aplicados a tu negocio.
        </p>
      </div>

      <div class="curriculum-grid">

        <div class="module-card">
          <div class="module-number">01</div>
          <div class="module-content">
            <h3 class="module-title">Fundamentos</h3>
            <p class="module-desc">Qué es Claude, cómo funciona y por qué es diferente. Entiendes el modelo, sus capacidades y límites.</p>
          </div>
          <div class="module-meta">2 sesiones</div>
        </div>

        <div class="module-card">
          <div class="module-number">02</div>
          <div class="module-content">
            <h3 class="module-title">Prompting</h3>
            <p class="module-desc">El arte de hablarle a Claude. Aprende a escribir instrucciones que obtienen resultados precisos y consistentes.</p>
          </div>
          <div class="module-meta">2 sesiones</div>
        </div>

        <div class="module-card">
          <div class="module-number">03</div>
          <div class="module-content">
            <h3 class="module-title">Claude: entorno y configuración</h3>
            <p class="module-desc">Dominas el entorno de Claude: claude.ai, proyectos, system prompts, memoria y configuración avanzada.</p>
          </div>
          <div class="module-meta">2 sesiones</div>
        </div>

        <div class="module-card">
          <div class="module-number">04</div>
          <div class="module-content">
            <h3 class="module-title">Conectores, MCPs y APIs</h3>
            <p class="module-desc">Conectas Claude con el mundo real. Integras herramientas externas, bases de datos y servicios via MCP y API.</p>
          </div>
          <div class="module-meta">2 sesiones</div>
        </div>

        <div class="module-card">
          <div class="module-number">05</div>
          <div class="module-content">
            <h3 class="module-title">Skills</h3>
            <p class="module-desc">Creas y usas skills para que Claude ejecute tareas especializadas de forma consistente y reutilizable.</p>
          </div>
          <div class="module-meta">2 sesiones</div>
        </div>

        <div class="module-card">
          <div class="module-number">06</div>
          <div class="module-content">
            <h3 class="module-title">Agentes</h3>
            <p class="module-desc">Construyes agentes que actúan de forma autónoma: investigan, deciden y ejecutan tareas sin que estés presente.</p>
          </div>
          <div class="module-meta">2 sesiones</div>
        </div>

        <div class="module-card">
          <div class="module-number">07</div>
          <div class="module-content">
            <h3 class="module-title">Scraping</h3>
            <p class="module-desc">Extraes y procesas información de cualquier fuente web. Claude analiza, limpia y estructura los datos.</p>
          </div>
          <div class="module-meta">2 sesiones</div>
        </div>

        <div class="module-card">
          <div class="module-number">08</div>
          <div class="module-content">
            <h3 class="module-title">Claude para tu Negocio</h3>
            <p class="module-desc">Aplicaciones directas al negocio: contenido, marketing, análisis de datos, atención al cliente y legal.</p>
          </div>
          <div class="module-meta">2 sesiones</div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── METODOLOGÍA ─── -->
  <section class="prog-section">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="badge-icon">⚡</span>
          <span class="badge-text">Cómo aprendes</span>
        </div>
        <h2 class="section-title">
          Aprendizaje <span class="title-gradient">aplicado desde el día 1</span>
        </h2>
      </div>

      <div class="method-grid">
        <div class="method-card">
          <div class="method-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 10l4.553-2.069A1 1 0 0121 8.87V15.13a1 1 0 01-1.447.9L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z"/>
            </svg>
          </div>
          <h3>Clases en vivo</h3>
          <p>2 sesiones por semana. Interactivas, con preguntas en tiempo real y ejercicios prácticos guiados.</p>
        </div>

        <div class="method-card">
          <div class="method-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/>
            </svg>
          </div>
          <h3>Grabaciones</h3>
          <p>Acceso permanente a todas las grabaciones. Repasa a tu ritmo, pausa, vuelve a ver cuando lo necesites.</p>
        </div>

        <div class="method-card">
          <div class="method-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
            </svg>
          </div>
          <h3>Comunidad privada</h3>
          <p>Acceso al grupo exclusivo de estudiantes. Comparte avances, resuelve dudas y conecta con otros builders de LATAM.</p>
        </div>

        <div class="method-card">
          <div class="method-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          </div>
          <h3>Proyectos reales</h3>
          <p>Cada módulo termina con un proyecto aplicado a tu negocio. Sales con resultados concretos, no solo teoría.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── PRECIO ─── -->
  <section class="prog-section prog-section-alt" id="precio">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="badge-icon">💳</span>
          <span class="badge-text">Inversión</span>
        </div>
        <h2 class="section-title">
          Un solo plan, <span class="title-gradient">todo incluido</span>
        </h2>
        <p class="section-subtitle">
          Sin niveles confusos. Un precio justo por acceso completo al programa.
        </p>
      </div>

      <div class="pricing-wrap">
        <div class="pricing-card">
          <div class="pricing-badge-top">Acceso completo</div>

          <div class="pricing-original">
            <span class="pricing-original-label">Precio regular</span>
            <span class="pricing-original-price">$499 USD</span>
          </div>

          <div class="pricing-amount">
            <span class="pricing-currency">USD</span>
            <span class="pricing-price">270</span>
            <div class="pricing-right">
              <span class="pricing-promo-badge">Precio especial</span>
              <span class="pricing-period">pago único · tiempo limitado</span>
            </div>
          </div>

          <ul class="pricing-features">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>10 módulos completos</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>16 sesiones en vivo</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Acceso permanente a grabaciones</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Comunidad privada de estudiantes</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Recursos, plantillas y prompts</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Proyectos aplicados por módulo</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Certificado de completación</span>
            </li>
          </ul>

          <a href="#registro" class="btn btn-primary pricing-cta">
            <span>Quiero inscribirme</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>

          <p class="pricing-note">
            🔒 Pago seguro · Cupos limitados por cohorte
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FAQs ─── -->
  <section class="prog-section" id="faq">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="badge-icon">❓</span>
          <span class="badge-text">Preguntas frecuentes</span>
        </div>
        <h2 class="section-title">
          Resolvemos tus <span class="title-gradient">dudas</span>
        </h2>
      </div>

      <div class="faq-list">
        <div class="faq-item">
          <button class="faq-question" onclick="toggleFaq(this)">
            <span>¿Necesito saber programar para tomar el programa?</span>
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>No. El programa está diseñado para personas sin experiencia técnica. Los módulos de código (Claude Code) están orientados a que puedas construir con lenguaje natural, sin escribir código tradicional.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" onclick="toggleFaq(this)">
            <span>¿En qué horario son las sesiones en vivo?</span>
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>Los horarios se confirman al cerrar la cohorte, considerando la zona horaria mayoritaria de los inscritos. Todas las sesiones quedan grabadas para quienes no puedan asistir en vivo.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" onclick="toggleFaq(this)">
            <span>¿Cuánto tiempo dura el programa en total?</span>
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>8 semanas, con 2 sesiones por semana. 16 clases en vivo más tiempo de práctica y proyectos. Un ritmo manejable sin que interfiera con tu trabajo o negocio.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" onclick="toggleFaq(this)">
            <span>¿Por cuánto tiempo tengo acceso a las grabaciones?</span>
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>Acceso permanente. Una vez inscrito, las grabaciones, recursos y materiales quedan disponibles indefinidamente en tu cuenta.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" onclick="toggleFaq(this)">
            <span>¿Hay soporte si tengo dudas durante el programa?</span>
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>Sí. Tienes acceso a la comunidad privada donde puedes resolver dudas, además de las sesiones en vivo donde puedes preguntar directamente. También contamos con canales de soporte por módulo.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" onclick="toggleFaq(this)">
            <span>¿Puedo pagar en mi moneda local?</span>
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>El precio es en USD pero aceptamos pagos desde cualquier país de LATAM a través de plataformas locales. Al inscribirte te indicamos las opciones disponibles para tu país.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FORMULARIO DE REGISTRO ─── -->
  <section class="prog-section prog-section-alt" id="registro">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="badge-icon">✍️</span>
          <span class="badge-text">Inscripción</span>
        </div>
        <h2 class="section-title">
          Reserva tu <span class="title-gradient">lugar</span>
        </h2>
        <p class="section-subtitle">
          Los cupos son limitados por cohorte. Déjanos tus datos y te confirmamos la fecha de inicio y el link de pago.
        </p>
      </div>

      <div class="form-wrap">
        <div class="form-card" id="formCard">

          <!-- Estado: Formulario -->
          <div id="formState">
            <form id="registroForm" novalidate>
              <div class="form-group">
                <label class="form-label" for="nombre">Nombre completo</label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  class="form-input"
                  placeholder="Tu nombre"
                  required
                  autocomplete="name"
                />
              </div>

              <div class="form-group">
                <label class="form-label" for="email">Correo electrónico</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="form-input"
                  placeholder="tu@correo.com"
                  required
                  autocomplete="email"
                />
              </div>

              <div class="form-group">
                <label class="form-label" for="telefono">Teléfono / WhatsApp</label>
                <input
                  type="tel"
                  id="telefono"
                  name="telefono"
                  class="form-input"
                  placeholder="+57 300 000 0000"
                  required
                  autocomplete="tel"
                />
              </div>

              <div id="formError" class="form-error" style="display:none"></div>

              <button type="submit" class="btn btn-primary form-submit" id="submitBtn">
                <span id="submitText">Reservar mi lugar</span>
                <svg id="submitArrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
                <svg id="submitSpinner" class="spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
                  <circle cx="12" cy="12" r="10" stroke-opacity="0.3"/>
                  <path d="M12 2a10 10 0 0 1 10 10"/>
                </svg>
              </button>

              <p class="form-privacy">
                🔒 Tus datos están seguros. Solo los usamos para contactarte sobre el programa.
              </p>
            </form>
          </div>

          <!-- Estado: Éxito -->
          <div id="successState" style="display:none" class="form-success">
            <div class="success-icon">🎉</div>
            <h3>¡Listo! Te registraste</h3>
            <p>Recibimos tus datos. Te contactaremos por WhatsApp y correo con los próximos pasos para asegurar tu lugar.</p>
            <p class="success-sub">Revisa también tu bandeja de spam por si acaso.</p>
          </div>

        </div>

        <!-- Sidebar info -->
        <div class="form-sidebar">
          <div class="form-sidebar-item">
            <span class="sidebar-icon">📅</span>
            <div>
              <strong>Próxima cohorte</strong>
              <p>Fecha por confirmar — cupos limitados</p>
            </div>
          </div>
          <div class="form-sidebar-item">
            <span class="sidebar-icon">💰</span>
            <div>
              <strong>$270 USD <s class="sidebar-original">$499</s></strong>
              <p>Precio especial · tiempo limitado</p>
            </div>
          </div>
          <div class="form-sidebar-item">
            <span class="sidebar-icon">🌎</span>
            <div>
              <strong>100% online</strong>
              <p>Desde cualquier país de LATAM</p>
            </div>
          </div>
          <div class="form-sidebar-item">
            <span class="sidebar-icon">🎓</span>
            <div>
              <strong>Certificado</strong>
              <p>Al completar el programa</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer />
  <Copyright />
</Layout>

<!-- ─── SCRIPTS ─── -->
<script>
  // ────────────────────────────────────────────────
  // Web3Forms — envía los datos a h@hazlolatam.com
  //
  // PENDIENTE (1 vez): obtener Access Key
  //   1. Ve a https://web3forms.com
  //   2. Ingresa h@hazlolatam.com y haz clic en "Create Access Key"
  //   3. Revisa el correo y copia la clave
  //   4. Pégala aquí abajo
  //
  const WEB3FORMS_KEY = "72b84a29-a0ce-48ff-b2e1-aa892b4b5d06";
  // ────────────────────────────────────────────────

  const form = document.getElementById("registroForm") as HTMLFormElement;
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
  const submitText = document.getElementById("submitText") as HTMLElement;
  const submitArrow = document.getElementById("submitArrow") as HTMLElement;
  const submitSpinner = document.getElementById("submitSpinner") as HTMLElement;
  const formError = document.getElementById("formError") as HTMLElement;
  const formState = document.getElementById("formState") as HTMLElement;
  const successState = document.getElementById("successState") as HTMLElement;

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    submitText.textContent = loading ? "Enviando..." : "Reservar mi lugar";
    submitArrow.style.display = loading ? "none" : "inline";
    submitSpinner.style.display = loading ? "inline" : "none";
  }

  function showError(msg: string) {
    formError.textContent = msg;
    formError.style.display = "block";
  }

  function hideError() {
    formError.style.display = "none";
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    hideError();

    const nombre = (document.getElementById("nombre") as HTMLInputElement).value.trim();
    const email = (document.getElementById("email") as HTMLInputElement).value.trim();
    const telefono = (document.getElementById("telefono") as HTMLInputElement).value.trim();

    if (!nombre || !email || !telefono) {
      showError("Por favor completa todos los campos.");
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError("Ingresa un correo electrónico válido.");
      return;
    }

    // Sin clave configurada → modo demo visual
    if (!WEB3FORMS_KEY) {
      formState.style.display = "none";
      successState.style.display = "flex";
      return;
    }

    setLoading(true);

    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          access_key: WEB3FORMS_KEY,
          subject: "Nueva inscripción — Claude para Profesionales",
          from_name: "Hazlo Programas",
          nombre,
          email,
          telefono,
          programa: "Claude para Profesionales",
        }),
      });

      const data = await res.json();
      if (!data.success) {
        console.error("[Web3Forms] Error:", data);
        throw new Error(data.message || "Error al enviar");
      }

      formState.style.display = "none";
      successState.style.display = "flex";
    } catch (err) {
      console.error("[Form] Submit error:", err);
      const waText = encodeURIComponent(`Hola! Quiero reservar mi lugar en Claude para Profesionales.\nNombre: ${nombre}\nEmail: ${email}\nTeléfono: ${telefono}`);
      formError.innerHTML = `Hubo un problema al enviar. <a href="https://wa.me/573133846633?text=${waText}" target="_blank" rel="noopener" style="color:#25d366;font-weight:600;text-decoration:underline">Escríbenos por WhatsApp →</a>`;
      formError.style.display = "block";
    } finally {
      setLoading(false);
    }
  });

  // FAQ Accordion
  function toggleFaq(btn: HTMLButtonElement) {
    const item = btn.closest(".faq-item") as HTMLElement;
    const isOpen = item.classList.contains("open");

    document.querySelectorAll(".faq-item.open").forEach((el) => el.classList.remove("open"));

    if (!isOpen) item.classList.add("open");
  }

  (window as any).toggleFaq = toggleFaq;
</script>

