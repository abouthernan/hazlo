---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Copyright from "../components/Copyright.astro";
---

<Layout
  title="De 0 a MVP en 8 Semanas — Hazlo"
  description="El programa para emprendedores que quieren construir, validar y lanzar su producto sin perder tiempo ni dinero."
>
  <Navbar />

  <!-- ─── HERO ─── -->
  <section class="prog-hero">
    <div class="container">
      <div class="prog-hero-inner">
        <div class="prog-badge">
          <span class="badge-dot"></span>
          <span>🔥 Precio de pre-lanzamiento — Precio sube a $600 pronto</span>
        </div>

        <h1 class="prog-hero-title">
          De 0 a <span class="title-gradient">MVP</span><br/>en 8 Semanas
        </h1>

        <p class="prog-hero-subtitle">
          El programa para emprendedores que quieren construir, validar y lanzar
          su producto sin perder tiempo ni dinero.
        </p>

        <div class="prog-hero-actions">
          <a href="#precio" class="btn btn-primary prog-cta">
            <span>Unirme al pre-lanzamiento por $499</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="#modulos" class="btn btn-secondary prog-cta-sec">
            Ver los 8 módulos
          </a>
        </div>

        <div class="prog-hero-stats">
          <div class="prog-stat">
            <span class="prog-stat-num">8</span>
            <span class="prog-stat-label">Semanas</span>
          </div>
          <div class="prog-stat-div"></div>
          <div class="prog-stat">
            <span class="prog-stat-num">8</span>
            <span class="prog-stat-label">Módulos</span>
          </div>
          <div class="prog-stat-div"></div>
          <div class="prog-stat">
            <span class="prog-stat-num">0→1</span>
            <span class="prog-stat-label">Idea a producto</span>
          </div>
          <div class="prog-stat-div"></div>
          <div class="prog-stat">
            <span class="prog-stat-num">🌎</span>
            <span class="prog-stat-label">100% Online</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── PARA QUIÉN ─── -->
  <section class="prog-section">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="badge-icon">🎯</span>
          <span class="badge-text">¿Para quién es?</span>
        </div>
        <h2 class="section-title">
          Este programa es para <span class="title-gradient">vos</span> si…
        </h2>
      </div>

      <div class="persona-grid">
        <div class="persona-card">
          <div class="persona-icon">💡</div>
          <h3>Tenés una idea sin ejecutar</h3>
          <p>Llevas tiempo con esa idea en la cabeza y querés convertirla en algo real de una vez. Ya es hora de salir del loop de pensar y entrar en modo construir.</p>
        </div>
        <div class="persona-card">
          <div class="persona-icon">📦</div>
          <h3>Tenés un producto pero sin ventas</h3>
          <p>Ya lanzaste algo pero no ves tracción. Necesitás validar si el mercado lo quiere, ajustar tu oferta y aprender a conseguir clientes de forma consistente.</p>
        </div>
        <div class="persona-card">
          <div class="persona-icon">🏢</div>
          <h3>Sos profesional y querés emprender</h3>
          <p>Tenés experiencia en tu industria, sabés que hay un problema que resolver, pero nunca tuviste el método ni la comunidad para dar el salto con inteligencia.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── MÓDULOS ─── -->
  <section class="prog-section prog-section-alt" id="modulos">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="badge-icon">📚</span>
          <span class="badge-text">El programa</span>
        </div>
        <h2 class="section-title">
          8 semanas. 8 módulos. <span class="title-gradient">Un producto que funciona.</span>
        </h2>
        <p class="section-subtitle">
          Cada semana trabajás un bloque fundamental del camino de 0 a MVP, con teoría, ejercicios prácticos y feedback.
        </p>
      </div>

      <div class="curriculum-grid">

        <div class="module-card">
          <div class="module-number">01</div>
          <div class="module-content">
            <div class="module-week">Semana 1</div>
            <h3 class="module-title">Mentalidad del Founder</h3>
            <ul class="module-topics">
              <li>Por qué la mayoría falla antes de empezar</li>
              <li>El cambio de mentalidad de empleado a emprendedor</li>
              <li>Cómo tomar decisiones con incertidumbre</li>
            </ul>
          </div>
        </div>

        <div class="module-card">
          <div class="module-number">02</div>
          <div class="module-content">
            <div class="module-week">Semana 2</div>
            <h3 class="module-title">Encuentra tu Idea y tu Mercado</h3>
            <ul class="module-topics">
              <li>Cómo identificar problemas que vale la pena resolver</li>
              <li>Herramientas para evaluar el tamaño del mercado</li>
              <li>De la idea al nicho: cómo enfocarte</li>
            </ul>
          </div>
        </div>

        <div class="module-card">
          <div class="module-number">03</div>
          <div class="module-content">
            <div class="module-week">Semana 3</div>
            <h3 class="module-title">Valida el Problema (Antes de Construir)</h3>
            <ul class="module-topics">
              <li>Técnica de entrevistas con clientes reales</li>
              <li>Cómo separar opiniones de evidencia real</li>
              <li>Señales de que hay un problema que duele</li>
            </ul>
          </div>
        </div>

        <div class="module-card">
          <div class="module-number">04</div>
          <div class="module-content">
            <div class="module-week">Semana 4</div>
            <h3 class="module-title">Diseña tu Solución</h3>
            <ul class="module-topics">
              <li>De las entrevistas a la propuesta de valor</li>
              <li>Cómo construir una solución que el mercado pidió</li>
              <li>Cuándo pivotar y cuándo avanzar</li>
            </ul>
          </div>
        </div>

        <div class="module-card">
          <div class="module-number">05</div>
          <div class="module-content">
            <div class="module-week">Semana 5</div>
            <h3 class="module-title">Construye tu Oferta</h3>
            <ul class="module-topics">
              <li>Cómo empaquetar tu solución para que sea irresistible</li>
              <li>Copywriting con el lenguaje de tu cliente</li>
              <li>Landing page que convierte desde el día 1</li>
            </ul>
          </div>
        </div>

        <div class="module-card">
          <div class="module-number">06</div>
          <div class="module-content">
            <div class="module-week">Semana 6</div>
            <h3 class="module-title">Consigue tus Primeros Clientes</h3>
            <ul class="module-topics">
              <li>Estrategias de adquisición sin presupuesto</li>
              <li>Cómo vender antes de tener el producto listo</li>
              <li>Tu primer cliente pagando: el hito que cambia todo</li>
            </ul>
          </div>
        </div>

        <div class="module-card">
          <div class="module-number">07</div>
          <div class="module-content">
            <div class="module-week">Semana 7</div>
            <h3 class="module-title">Construye tu MVP</h3>
            <ul class="module-topics">
              <li>Qué construir exactamente (y qué no)</li>
              <li>Herramientas no-code y low-code para lanzar rápido</li>
              <li>Cómo iterar con feedback real</li>
            </ul>
          </div>
        </div>

        <div class="module-card">
          <div class="module-number">08</div>
          <div class="module-content">
            <div class="module-week">Semana 8</div>
            <h3 class="module-title">Lanza y Escala</h3>
            <ul class="module-topics">
              <li>Tu plan de lanzamiento paso a paso</li>
              <li>Métricas que importan en etapa temprana</li>
              <li>De MVP a producto con tracción</li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── PRECIO ─── -->
  <section class="prog-section" id="precio">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="badge-icon">💳</span>
          <span class="badge-text">Inversión</span>
        </div>
        <h2 class="section-title">
          Precio de <span class="title-gradient">pre-lanzamiento</span>
        </h2>
        <p class="section-subtitle">
          Acceso anticipado con el precio más bajo que tendrá el programa.
        </p>
      </div>

      <div class="pricing-wrap">
        <div class="pricing-card">
          <div class="pricing-badge-top">Pre-lanzamiento · Plazas limitadas</div>

          <div class="pricing-original">
            <span class="pricing-original-label">Precio regular</span>
            <span class="pricing-original-price">$600 USD</span>
          </div>

          <div class="pricing-amount">
            <span class="pricing-currency">USD</span>
            <span class="pricing-price">499</span>
            <div class="pricing-right">
              <span class="pricing-promo-badge">Pre-lanzamiento</span>
              <span class="pricing-period">pago único · acceso completo</span>
            </div>
          </div>

          <ul class="pricing-features">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>8 módulos con contenido en video + material descargable</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Ejercicios prácticos por semana con feedback</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Acceso a la comunidad privada de founders</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Sesiones en vivo con preguntas y respuestas</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Acceso de por vida al material y futuras actualizaciones</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Certificado de finalización del programa</span>
            </li>
          </ul>

          <a href="#registro" class="btn btn-primary pricing-cta">
            <span>Quiero mi lugar</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>

          <p class="pricing-note">
            🔒 Pago seguro · El precio sube a $600 pronto
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FAQ ─── -->
  <section class="prog-section prog-section-alt" id="faq">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="badge-icon">❓</span>
          <span class="badge-text">Preguntas frecuentes</span>
        </div>
        <h2 class="section-title">
          Todo lo que necesitás <span class="title-gradient">saber</span>
        </h2>
      </div>

      <div class="faq-list">

        <div class="faq-item">
          <button class="faq-question" onclick="toggleFaq(this)">
            <span>¿Cuánto tiempo debo dedicarle por semana?</span>
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>El programa está diseñado para que le dediques entre 3 y 5 horas semanales. Podés avanzar a tu ritmo y el material está disponible para que lo veas cuando tengas tiempo.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" onclick="toggleFaq(this)">
            <span>¿Necesito saber programar o tener conocimientos técnicos?</span>
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>No. El módulo de construcción del MVP está enfocado en herramientas no-code y low-code que permiten lanzar un producto funcional sin escribir código. Si tenés conocimientos técnicos, genial — si no, también vas a poder construir algo real.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" onclick="toggleFaq(this)">
            <span>¿Hay garantía de devolución?</span>
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>Sí. Tenés 14 días desde el inicio del programa para revisar el contenido. Si sentís que no es lo que esperabas, te devolvemos el 100% de tu inversión sin preguntas.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" onclick="toggleFaq(this)">
            <span>¿Qué pasa si no puedo seguir el ritmo semanal?</span>
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>Sin problema. Tenés acceso de por vida al material, así que si una semana no podés avanzar, podés retomarlo cuando quieras. El programa está pensado para personas con vida activa.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" onclick="toggleFaq(this)">
            <span>¿Cuándo empieza el programa?</span>
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>Estamos en fase de pre-lanzamiento. Quienes se inscriban ahora tendrán acceso anticipado al material y a la comunidad, y serán los primeros en iniciar cuando abramos oficialmente.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── URGENCIA ─── -->
  <section class="urgencia-section">
    <div class="container">
      <div class="urgencia-content">
        <h2 class="urgencia-title">
          Cada día que no actuás,<br/>
          <span class="title-gradient">alguien más lanza la idea<br/>que vos tenés en la cabeza.</span>
        </h2>
        <p class="urgencia-sub">
          El conocimiento no es el problema. La ejecución sí. Este programa existe para que en 8 semanas tengas algo real: un producto, clientes y un camino claro.
        </p>
        <a href="#precio" class="btn btn-primary urgencia-cta">
          <span>Unirme por $499 antes de que suba el precio</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── FORMULARIO DE REGISTRO ─── -->
  <section class="prog-section" id="registro">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span class="badge-icon">✍️</span>
          <span class="badge-text">Inscripción</span>
        </div>
        <h2 class="section-title">
          Reserva tu <span class="title-gradient">lugar</span>
        </h2>
        <p class="section-subtitle">
          Los cupos son limitados. Déjanos tus datos y te confirmamos la fecha de inicio y el link de pago.
        </p>
      </div>

      <div class="form-wrap">
        <div class="form-card" id="formCard">

          <!-- Estado: Formulario -->
          <div id="formState">
            <form id="registroForm" novalidate>
              <div class="form-group">
                <label class="form-label" for="nombre">Nombre completo</label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  class="form-input"
                  placeholder="Tu nombre"
                  required
                  autocomplete="name"
                />
              </div>

              <div class="form-group">
                <label class="form-label" for="email">Correo electrónico</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="form-input"
                  placeholder="tu@correo.com"
                  required
                  autocomplete="email"
                />
              </div>

              <div class="form-group">
                <label class="form-label" for="telefono">Teléfono / WhatsApp</label>
                <input
                  type="tel"
                  id="telefono"
                  name="telefono"
                  class="form-input"
                  placeholder="+57 300 000 0000"
                  required
                  autocomplete="tel"
                />
              </div>

              <div id="formError" class="form-error" style="display:none"></div>

              <button type="submit" class="btn btn-primary form-submit" id="submitBtn">
                <span id="submitText">Reservar mi lugar</span>
                <svg id="submitArrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
                <svg id="submitSpinner" class="spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
                  <circle cx="12" cy="12" r="10" stroke-opacity="0.3"/>
                  <path d="M12 2a10 10 0 0 1 10 10"/>
                </svg>
              </button>

              <p class="form-privacy">
                🔒 Tus datos están seguros. Solo los usamos para contactarte sobre el programa.
              </p>
            </form>
          </div>

          <!-- Estado: Éxito -->
          <div id="successState" style="display:none" class="form-success">
            <div class="success-icon">🎉</div>
            <h3>¡Listo! Te registraste</h3>
            <p>Recibimos tus datos. Te contactaremos por WhatsApp y correo con los próximos pasos para asegurar tu lugar.</p>
            <p class="success-sub">Revisa también tu bandeja de spam por si acaso.</p>
          </div>

        </div>

        <!-- Sidebar info -->
        <div class="form-sidebar">
          <div class="form-sidebar-item">
            <span class="sidebar-icon">📅</span>
            <div>
              <strong>Próxima cohorte</strong>
              <p>Fecha por confirmar — cupos limitados</p>
            </div>
          </div>
          <div class="form-sidebar-item">
            <span class="sidebar-icon">💰</span>
            <div>
              <strong>$499 USD <s class="sidebar-original">$600</s></strong>
              <p>Pre-lanzamiento · tiempo limitado</p>
            </div>
          </div>
          <div class="form-sidebar-item">
            <span class="sidebar-icon">🌎</span>
            <div>
              <strong>100% online</strong>
              <p>Desde cualquier país de LATAM</p>
            </div>
          </div>
          <div class="form-sidebar-item">
            <span class="sidebar-icon">🎓</span>
            <div>
              <strong>Certificado</strong>
              <p>Al completar el programa</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer />
  <Copyright />
</Layout>

<script>
  const WEB3FORMS_KEY = "5b77b08d-0154-48e3-af84-48fdd6543a4e";

  const form = document.getElementById("registroForm") as HTMLFormElement;
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
  const submitText = document.getElementById("submitText") as HTMLElement;
  const submitArrow = document.getElementById("submitArrow") as HTMLElement;
  const submitSpinner = document.getElementById("submitSpinner") as HTMLElement;
  const formError = document.getElementById("formError") as HTMLElement;
  const formState = document.getElementById("formState") as HTMLElement;
  const successState = document.getElementById("successState") as HTMLElement;

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    submitText.textContent = loading ? "Enviando..." : "Reservar mi lugar";
    submitArrow.style.display = loading ? "none" : "inline";
    submitSpinner.style.display = loading ? "inline" : "none";
  }

  function showError(msg: string) {
    formError.textContent = msg;
    formError.style.display = "block";
  }

  function hideError() {
    formError.style.display = "none";
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    hideError();

    const nombre = (document.getElementById("nombre") as HTMLInputElement).value.trim();
    const email = (document.getElementById("email") as HTMLInputElement).value.trim();
    const telefono = (document.getElementById("telefono") as HTMLInputElement).value.trim();

    if (!nombre || !email || !telefono) {
      showError("Por favor completa todos los campos.");
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError("Ingresa un correo electrónico válido.");
      return;
    }

    setLoading(true);

    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          access_key: WEB3FORMS_KEY,
          subject: "Nueva inscripción — De 0 a MVP en 8 Semanas",
          from_name: "Hazlo Programas",
          nombre,
          email,
          telefono,
          programa: "De 0 a MVP en 8 Semanas",
        }),
      });

      const data = await res.json();
      if (!data.success) {
        console.error("[Web3Forms] Error:", data);
        throw new Error(data.message || "Error al enviar");
      }

      formState.style.display = "none";
      successState.style.display = "flex";
    } catch (err) {
      console.error("[Form] Submit error:", err);
      const waText = encodeURIComponent(`Hola! Quiero reservar mi lugar en De 0 a MVP en 8 Semanas.\nNombre: ${nombre}\nEmail: ${email}\nTeléfono: ${telefono}`);
      formError.innerHTML = `Hubo un problema al enviar. <a href="https://wa.me/573133846633?text=${waText}" target="_blank" rel="noopener" style="color:#25d366;font-weight:600;text-decoration:underline">Escríbenos por WhatsApp →</a>`;
      formError.style.display = "block";
    } finally {
      setLoading(false);
    }
  });

  function toggleFaq(btn: HTMLButtonElement) {
    const item = btn.closest(".faq-item") as HTMLElement;
    const isOpen = item.classList.contains("open");
    document.querySelectorAll(".faq-item.open").forEach((el) => el.classList.remove("open"));
    if (!isOpen) item.classList.add("open");
  }

  (window as any).toggleFaq = toggleFaq;
